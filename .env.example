# Copy to .env and adjust. Everything runs locally by default.

# Where tables, vectors, lineage logs and private files live (git-ignored)
JOBRADAR_DATA_DIR=./data

# Any OpenAI-compatible endpoint. Default: Ollama on your Mac.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
EMBED_MODEL=bge-m3

# "openai" uses the endpoint above; "fake" runs deterministic stand-ins (tests, CI, demos without models)
JOBRADAR_PROVIDER=openai

# Marquez lineage API. Leave empty to only write lineage to the local event log.
OPENLINEAGE_URL=http://localhost:5050
OPENLINEAGE_NAMESPACE=jobradar

# Adzuna (optional source). Free key: https://developer.adzuna.com/signup
# Put the real values only in your own .env, which is git-ignored. Never commit them.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
